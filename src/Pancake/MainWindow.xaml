<Window
    x:Class="Pancake.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Pancake.Controls"
    Title="Pancake 班级作业看板">

    <Grid x:Name="RootShell" Background="Transparent" KeyDown="RootShell_KeyDown" SizeChanged="RootShell_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,0" Background="{ThemeResource BoardSurfaceBrush}" BorderBrush="{ThemeResource BoardLineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="BrandRegion" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="38" Height="38" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="8">
                        <icons:FluentIcon FontSize="18" Foreground="{ThemeResource BoardBrandBrush}" Symbol="Board" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="Pancake" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource BoardTextBrush}" Text="班级作业看板" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ProjectCommands" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                <DropDownButton x:Name="ProjectPicker" MaxWidth="260">
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <icons:FluentIcon Symbol="Folder" />
                            <TextBlock x:Name="ProjectNameText" Text="选择项目" />
                            <TextBlock x:Name="SubjectCountText" Foreground="{ThemeResource BoardTextMutedBrush}" />
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout><Flyout Opening="RecentProjects_Opening"><ScrollViewer MaxHeight="420" Width="240"><StackPanel x:Name="RecentProjectsPanel" Spacing="8" /></ScrollViewer></Flyout></DropDownButton.Flyout>
                </DropDownButton>
                <DropDownButton>
                    <DropDownButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="7"><icons:FluentIcon Symbol="Document" /><TextBlock Text="文件" /></StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout><MenuFlyout>
                        <MenuFlyoutItem Text="新建" Click="NewProject_Click" />
                        <MenuFlyoutItem x:Name="RenameProjectMenu" Text="重命名" Click="RenameProject_Click" />
                        <MenuFlyoutItem x:Name="DeleteProjectMenu" Text="删除" Click="DeleteProject_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="导入" Click="ImportProject_Click" />
                        <MenuFlyoutItem x:Name="SaveProjectMenu" Text="保存" Click="SaveProject_Click" />
                        <MenuFlyoutItem x:Name="ExportProjectMenu" Text="导出" Click="ExportImage_Click" />
                    </MenuFlyout></DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            <Grid Grid.Column="2" Margin="0,0,140,0">
                <Grid x:Name="DragRegion" Background="Transparent" />
                <ScrollViewer x:Name="RichTextToolbar" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <ContentControl x:Name="RichTextToolbarHost" HorizontalContentAlignment="Right" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="DisplayRoot" Grid.Row="1" Background="{ThemeResource BoardBackgroundBrush}">
            <icons:BackgroundVisual x:Name="SharedBackgroundVisual" />
            <Grid x:Name="DisplayGrid">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="400" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Border x:Name="ClockPanel" Grid.Row="0" Grid.Column="0" Background="{ThemeResource BoardSurfaceBrush}" BorderBrush="{ThemeResource BoardLineBrush}" BorderThickness="0,0,1,0" SizeChanged="ClockPanel_SizeChanged">
                    <Grid>
                        <icons:BackgroundVisual x:Name="ClockBackgroundVisual" />
                        <Canvas x:Name="ClockLayoutCanvas">
                            <Viewbox x:Name="ClockContentView" Stretch="Uniform">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                        <TextBlock x:Name="MainTimeText" FontFamily="{StaticResource BoardTextFontFamily}" FontSize="112" FontWeight="Light" Foreground="{ThemeResource BoardTextBrush}" Text="11:20" />
                                        <TextBlock x:Name="SecondsText" Margin="0,17,0,0" VerticalAlignment="Top" FontFamily="{StaticResource BoardTextFontFamily}" FontSize="28" Foreground="{ThemeResource BoardTextBrush}" Text="10" />
                                    </StackPanel>
                                    <TextBlock x:Name="ClockDateText" HorizontalAlignment="Center" FontSize="20" Foreground="{ThemeResource BoardTextBrush}" />
                                </StackPanel>
                            </Viewbox>
                            <Viewbox x:Name="ClockComponentsView" Stretch="Uniform">
                                <StackPanel x:Name="ClockComponents" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <Border x:Name="WeatherWidget" Padding="16,10" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="9"><icons:FluentIcon Foreground="{ThemeResource BoardWarningBrush}" Symbol="Weather" /><TextBlock x:Name="WeatherText" FontSize="14" Foreground="{ThemeResource BoardTextBrush}" Text="天气未配置" /></StackPanel>
                                    </Border>
                                    <Border x:Name="NoiseWidget" Padding="16,10" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="9"><icons:FluentIcon Foreground="{ThemeResource BoardSuccessBrush}" Symbol="Microphone" /><TextBlock x:Name="NoiseText" FontSize="14" Foreground="{ThemeResource BoardTextBrush}" Text="42 dB · 安静" /></StackPanel>
                                    </Border>
                                </StackPanel>
                            </Viewbox>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid x:Name="BoardWorkspace" Grid.Row="0" Grid.Column="1" Background="{ThemeResource BoardSurfaceBrush}">
                    <icons:BackgroundVisual x:Name="BoardBackgroundVisual" /><ScrollViewer x:Name="BoardScroller" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" ZoomMode="Disabled" HorizontalScrollMode="Disabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" MinZoomFactor="0.2" MaxZoomFactor="4"><Grid x:Name="BoardViewport" Background="Transparent" SizeChanged="BoardViewport_SizeChanged">
                        <Grid x:Name="BoardSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                            <Canvas x:Name="GridCanvas" IsHitTestVisible="False" />
                            <Canvas x:Name="BoardCanvas" />
                            <Canvas x:Name="AlignmentCanvas" IsHitTestVisible="False" />
                        </Grid>
                    </Grid></ScrollViewer>
                </Grid>
            </Grid>
            <Canvas x:Name="FreeWidgetsCanvas" /><Canvas x:Name="FreeLayoutHandles" IsHitTestVisible="False" />
        </Grid>

        <NavigationView x:Name="SettingsRoot" Grid.Row="1" Visibility="Collapsed"
                        PaneDisplayMode="Left" OpenPaneLength="260" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneOpen="True" Loaded="SettingsRoot_Loaded"
                        SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="布局" Tag="Layout"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Layout" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="AppearanceNavigationGroup" Content="外观" IsExpanded="True" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><icons:FluentIcon Symbol="Color" /></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="AppearanceNavItem" Content="磁贴" Tag="AppearanceTile" IsSelected="True"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Grid" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="背景板" Tag="AppearanceBackground"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Image" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="主题" Tag="AppearanceTheme"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Color" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="控制窗" Tag="AppearanceToolbar"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Settings" /></NavigationViewItem.Icon></NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ComponentsNavigationGroup" Content="组件" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><icons:FluentIcon Symbol="Components" /></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="天气" Tag="ComponentsWeather"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Weather" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="噪音检测" Tag="ComponentsNoise"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Microphone" /></NavigationViewItem.Icon></NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavigationGroup" Content="关于" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon><icons:FluentIcon Symbol="Info" /></NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="仓库" Tag="AboutRepositories"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Folder" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem x:Name="AboutVersionNavItem" Content="版本" Tag="AboutVersion"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Info" /></NavigationViewItem.Icon></NavigationViewItem>
                        <NavigationViewItem Content="更新" Tag="AboutUpdate"><NavigationViewItem.Icon><icons:FluentIcon Symbol="Reset" /></NavigationViewItem.Icon></NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <ScrollViewer x:Name="SettingsContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel Padding="32,28,32,100" Spacing="28">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SettingsPageTitle" FontSize="36" Foreground="{ThemeResource BoardTextBrush}" Text="磁贴" />
                    <TextBlock x:Name="SettingsPageDescription" FontSize="15" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="调整磁贴标题和背景样式。" />
                </StackPanel>
                <StackPanel x:Name="LayoutSettingsPanel" Visibility="Collapsed" />
                <StackPanel x:Name="AppearanceSettingsPanel" Spacing="22">
                <Border x:Name="ThemeSettingsCard" Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="主题" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock FontSize="15" FontWeight="SemiBold" Text="主题" /><TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="深色更接近教室黑板，强光环境可切换浅色" /></StackPanel>
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="深色" Tag="Dark" /><ComboBoxItem Content="浅色" Tag="Light" /><ComboBoxItem Content="跟随系统" Tag="Default" />
                            </ComboBox>
                        </Grid>
                        <ComboBox x:Name="PaletteComboBox" Header="色系" SelectedIndex="0" SelectionChanged="PaletteComboBox_SelectionChanged">
                            <ComboBoxItem Content="鲜艳" /><ComboBoxItem Content="马卡龙" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                </StackPanel>
                <StackPanel x:Name="ComponentSettingsPanel" Spacing="22" Visibility="Collapsed">
                <Border x:Name="WeatherSettingsCard" Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="天气" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="使用 小米天气API ，请在下方选择地区" />
                        <ToggleSwitch x:Name="WeatherAlertsToggle" Header="显示极端天气预警" IsOn="True" Toggled="WeatherAlertsToggle_Toggled" />
                        <TextBlock x:Name="WeatherAlertsText" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="WeatherCityTextBox" Header="地区" Text="北京" IsReadOnly="True" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseWeatherCityButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="选择地区" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="RefreshWeatherButton_Click" Style="{StaticResource BoardPrimaryButtonStyle}" Content="测试并刷新" />
                            <TextBlock x:Name="WeatherStatusText" MaxWidth="560" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="等待配置" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="NoiseSettingsCard" Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="麦克风噪音检测" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="只计算实时音量，不录音、不保存音频；系统拒绝麦克风权限时会停止检测。" />
                        <TextBlock x:Name="NoiseIntervalLabel" Text="检测间隔 · 0.1 秒" />
                        <Slider x:Name="NoiseIntervalSlider" Minimum="0.1" Maximum="2" StepFrequency="0.1" TickFrequency="0.1" SnapsTo="StepValues" Value="0.1" ValueChanged="NoiseIntervalSlider_ValueChanged" />
                        <ComboBox x:Name="MicrophoneDeviceComboBox" Header="输入设备" HorizontalAlignment="Stretch" SelectionChanged="MicrophoneDeviceComboBox_SelectionChanged" />
                        <Button Content="刷新输入设备" Click="RefreshMicrophoneDevices_Click" Style="{StaticResource BoardSecondaryButtonStyle}" />
                        <TextBlock x:Name="NoiseThresholdLabel" Text="吵闹阈值 · 60 dB" />
                        <Slider x:Name="NoiseThresholdSlider" Minimum="20" Maximum="120" StepFrequency="1" Value="60" ValueChanged="NoiseThresholdSlider_ValueChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <ToggleSwitch x:Name="NoiseAlertToggle" Header="吵闹时播放提示音" Toggled="NoiseAlertToggle_Toggled" />
                            <Button Content="试听" Click="PreviewNoiseAlert_Click" VerticalAlignment="Bottom" Style="{StaticResource BoardSecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="NoiseAlertVolumeLabel" Text="提示音音量 · 100%" />
                        <Slider x:Name="NoiseAlertVolumeSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="100" ValueChanged="NoiseAlertVolumeSlider_ValueChanged" />
                        <TextBlock Text="先选择当前环境的实际音量，再点击校准；更换麦克风后请重新校准。" TextWrapping="Wrap" />
                        <NumberBox x:Name="CalibrationTargetBox" Header="当前环境音量（dB）" Minimum="20" Maximum="120" Value="40" SmallChange="1" SpinButtonPlacementMode="Inline" />
                        <Button Content="校准" Click="CalibrateMicrophone_Click" Style="{StaticResource BoardPrimaryButtonStyle}" />
                        <TextBlock x:Name="MicrophoneCalibrationLabel" Text="校准偏移 · 0 dB" />
                        <InfoBar x:Name="MicrophoneStatusInfoBar" IsClosable="False" IsOpen="True" Severity="Informational" Message="正在等待麦克风启动" />
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel x:Name="AboutSettingsPanel" Spacing="24" Visibility="Collapsed">
                    <Border x:Name="VersionSettingsCard" Style="{StaticResource BoardCardStyle}">
                        <StackPanel Spacing="24">
                            <TextBlock FontSize="22" Text="应用信息" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="版本" VerticalAlignment="Center" />
                                <TextBlock x:Name="AppVersionText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource BoardLineBrush}" />
                            <Grid x:Name="RepositorySettingsCard" ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="项目仓库" VerticalAlignment="Center" />
                                <HyperlinkButton Grid.Column="1" NavigateUri="https://github.com/Edge-HH/Pancake" Background="{ThemeResource BoardSurfaceSecondaryBrush}" CornerRadius="8" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                                            <Path
                                                Width="98"
                                                Height="96"
                                                Fill="{ThemeResource GitHubIconBrush}"
                                                Stretch="Uniform"
                                                Data="M48.854,0 C21.839,0 0,22 0,49.217 C0,70.973 13.993,89.389 33.405,95.902 C35.832,96.352 36.72,94.843 36.72,93.546 C36.72,92.382 36.675,88.513 36.654,84.407 C23.064,87.379 20.193,78.602 20.193,78.602 C17.97,72.892 14.765,71.372 14.765,71.372 C10.322,68.315 15.099,68.377 15.099,68.377 C20.011,68.725 22.599,73.455 22.599,73.455 C26.966,80.995 34.049,78.815 36.842,77.555 C37.282,74.365 38.55,72.195 39.95,70.965 C29.102,69.721 17.699,65.485 17.699,46.578 C17.699,41.192 19.615,36.788 22.767,33.332 C22.256,32.085 20.572,27.076 23.243,20.292 C23.243,20.292 27.38,18.96 36.791,25.352 C40.712,24.255 44.933,23.705 49.122,23.685 C53.311,23.705 57.532,24.255 61.472,25.352 C70.873,18.96 75.005,20.292 75.005,20.292 C77.682,27.076 75.999,32.085 75.488,33.332 C78.646,36.788 80.55,41.192 80.55,46.578 C80.55,65.533 69.125,69.708 58.25,70.93 C60.006,72.455 61.568,75.449 61.568,80.035 C61.568,86.615 61.511,91.905 61.511,93.532 C61.511,94.838 62.386,96.359 64.848,95.882 C84.013,89.36 98,70.95 98,49.217 C98,22 76.161,0 48.854,0 Z" />
                                        </Viewbox>
                                        <StackPanel><TextBlock Text="Edge-HH/Pancake" FontWeight="SemiBold" /><TextBlock Text="在 GitHub 中打开" FontSize="12" Foreground="{ThemeResource BoardTextSecondaryBrush}" /></StackPanel>
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="UpdateSettingsCard" Style="{StaticResource BoardCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock FontSize="22" Text="更新" />
                            <TextBlock Text="本软件使用 HarmonyOS Sans 字体与 Fluent System Icons。字体版权与完整许可见程序 Assets/Fonts 目录。" TextWrapping="Wrap" />
                            <TextBlock Text="从所选更新源获取并安装最新版本。" Foreground="{ThemeResource BoardTextSecondaryBrush}" />
                            <ComboBox x:Name="UpdateSourceComboBox" Header="更新源"><ComboBoxItem Content="GitHub" /><ComboBoxItem Content="Gitee" /></ComboBox>
                            <TextBlock x:Name="UpdateSourceHint" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="AutoUpdateToggle" Header="启动时自动检查更新" IsOn="True" Toggled="AutoUpdateToggle_Toggled" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="尚未检查" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Click="CheckUpdateButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="检查更新" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <StackPanel x:Name="EmptyProjectPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
            <TextBlock Text="创建或导入一个作业项目" FontSize="24" />
            <Button Content="新建项目" Click="NewProject_Click" HorizontalAlignment="Center" />
            <Button Content="导入 .pch" Click="ImportProject_Click" HorizontalAlignment="Center" />
        </StackPanel>
        <InfoBar x:Name="StorageInfoBar" Grid.Row="1" VerticalAlignment="Top" Canvas.ZIndex="150" Severity="Error" IsOpen="False" />
        <Border x:Name="GlobalInkToolbar" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,94" Padding="12" Background="{ThemeResource BoardSurfaceBrush}" BorderBrush="{ThemeResource BoardLineBrush}" BorderThickness="1" CornerRadius="12" Canvas.ZIndex="110" Visibility="Collapsed">
            <ScrollViewer x:Name="InkToolbarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="GlobalInkTools" Orientation="Horizontal" Spacing="10" /></ScrollViewer>
        </Border>
        <Grid x:Name="ExportOverlay" Grid.RowSpan="2" Canvas.ZIndex="200" Background="{ThemeResource BoardBackgroundBrush}" Visibility="Collapsed" />

        <!-- 主操作集中在屏幕下方，触屏时不需要跨越整块大屏。 -->
        <Border
            x:Name="FloatingToolbar"
            Grid.RowSpan="2"
            Margin="0,0,0,24"
            Padding="7"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource BoardSurfaceBrush}"
            BorderBrush="{ThemeResource BoardLineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Canvas.ZIndex="100">
            <ScrollViewer x:Name="MainToolbarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ToolbarItems" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="GlobalPenButton" Width="44" Height="44" Padding="10" Background="Transparent" BorderThickness="0" Visibility="Collapsed" AutomationProperties.Name="画笔" Checked="GlobalPen_Changed" Unchecked="GlobalPen_Changed">
                    <icons:FluentIcon Symbol="Pen" />
                </ToggleButton>
                <Button x:Name="BackToBoardButton" Click="BackToBoardButton_Click" Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="返回看板">
                    <icons:FluentIcon Symbol="Back" />
                </Button>
                <Button x:Name="AddSubjectButton" Click="AddSubjectButton_Click" Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="添加科目">
                    <icons:FluentIcon Symbol="Add" />
                </Button>
                <Button x:Name="AutoArrangeButton" Click="AutoArrangeButton_Click" Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="自动排列磁贴">
                    <icons:FluentIcon Symbol="Layout" />
                </Button>
                <ToggleButton
                    x:Name="GridSnapToggleButton"
                    Width="44"
                    Height="44"
                    Padding="10"
                    Background="Transparent"
                    BorderThickness="0"
                    IsChecked="True"
                    Visibility="Collapsed"
                    AutomationProperties.Name="网格吸附"
                    Checked="GridSnapToggleButton_Checked"
                    Unchecked="GridSnapToggleButton_Unchecked">
                    <icons:FluentIcon FontSize="18" Symbol="Grid" />
                </ToggleButton>
                <Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="设置">
                    <icons:FluentIcon Symbol="Settings" />
                </Button>
                <Button x:Name="FullScreenButton" Click="FullScreenButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="进入全屏">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <icons:FluentIcon x:Name="FullScreenIcon" Symbol="FullScreen" />
                        <TextBlock x:Name="FullScreenLabel" Text="退出全屏" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
                <Button x:Name="DiscardEditButton" Click="DiscardEditButton_Click" Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="放弃修改">
                    <icons:FluentIcon Symbol="Dismiss" />
                </Button>
                <Button x:Name="EditBoardButton" Click="EditBoardButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="编辑看板">
                    <icons:FluentIcon x:Name="EditBoardIcon" Symbol="Edit" />
                </Button>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</Window>
