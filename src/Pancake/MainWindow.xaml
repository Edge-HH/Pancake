<Window
    x:Class="Pancake.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pancake 班级作业看板">

    <Grid x:Name="RootShell" Background="{ThemeResource BoardBackgroundBrush}" KeyDown="RootShell_KeyDown" SizeChanged="RootShell_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,0" Background="{ThemeResource BoardSurfaceBrush}" BorderBrush="{ThemeResource BoardLineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragRegion" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="38" Height="38" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="8">
                        <FontIcon FontSize="18" Foreground="{ThemeResource BoardBrandBrush}" Glyph="&#xE823;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="Pancake" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource BoardTextBrush}" Text="班级作业看板" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Margin="0,0,140,0" VerticalAlignment="Center">
                <TextBlock x:Name="TopDateText" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource BoardTextBrush}" />
                <Grid x:Name="RichTextToolbar" Visibility="Collapsed" MinWidth="198">
                    <TextBlock x:Name="RichTextToolbarHint" Text="点击作业文字以设置样式" FontSize="13" Foreground="{ThemeResource BoardTextBrush}" VerticalAlignment="Center" />
                    <ContentControl x:Name="RichTextToolbarHost" HorizontalContentAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="DisplayRoot" Grid.Row="1">
            <Grid x:Name="DisplayGrid">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="400" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Border x:Name="ClockPanel" Grid.Row="0" Grid.Column="0" Background="{ThemeResource BoardSurfaceBrush}" BorderBrush="{ThemeResource BoardLineBrush}" BorderThickness="0,0,1,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="MainTimeText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="112" FontWeight="Light" Foreground="{ThemeResource BoardTextBrush}" Text="11:20" />
                            <TextBlock x:Name="SecondsText" Margin="0,17,0,0" VerticalAlignment="Top" FontFamily="Cascadia Code, Consolas" FontSize="28" Foreground="{ThemeResource BoardTextBrush}" Text="10" />
                        </StackPanel>
                        <TextBlock x:Name="ClockDateText" HorizontalAlignment="Center" FontSize="20" Foreground="{ThemeResource BoardTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Padding="16,10" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Foreground="{ThemeResource BoardWarningBrush}" Glyph="&#xE706;" /><TextBlock x:Name="WeatherText" FontSize="14" Foreground="{ThemeResource BoardTextBrush}" Text="天气未配置" /></StackPanel>
                            </Border>
                            <Border Padding="16,10" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Foreground="{ThemeResource BoardSuccessBrush}" Glyph="&#xE720;" /><TextBlock x:Name="NoiseText" FontSize="14" Foreground="{ThemeResource BoardTextBrush}" Text="42 dB · 安静" /></StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid x:Name="BoardWorkspace" Grid.Row="0" Grid.Column="1" Background="{ThemeResource BoardSurfaceBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="30,0,24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="今日作业" />
                            <TextBlock x:Name="BoardModeHint" FontSize="12" Foreground="{ThemeResource BoardTextBrush}" Text="所有文字和笔迹都完整显示在磁贴上" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="11,6" VerticalAlignment="Center" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="8">
                            <TextBlock x:Name="SubjectCountText" FontSize="12" Foreground="{ThemeResource BoardTextBrush}" />
                        </Border>
                    </Grid>
                    <Grid x:Name="BoardViewport" Grid.Row="1" Background="{ThemeResource BoardSurfaceBrush}" SizeChanged="BoardViewport_SizeChanged">
                        <Grid x:Name="BoardSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{ThemeResource BoardSurfaceBrush}">
                            <Canvas x:Name="GridCanvas" IsHitTestVisible="False" />
                            <Canvas x:Name="BoardCanvas" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <NavigationView x:Name="SettingsRoot" Grid.Row="1" Visibility="Collapsed"
                        PaneDisplayMode="Left" OpenPaneLength="260" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneOpen="True" SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AppearanceNavItem" Content="外观" Tag="Appearance" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="组件" Tag="Components"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80A;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="关于" Tag="About"><NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="SettingsContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
            <StackPanel Padding="32,28,32,100" Spacing="28">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SettingsPageTitle" FontSize="36" Foreground="{ThemeResource BoardTextBrush}" Text="外观" />
                    <TextBlock x:Name="SettingsPageDescription" FontSize="15" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="调整界面主题和看板色系。" />
                </StackPanel>
                <StackPanel x:Name="AppearanceSettingsPanel" Spacing="22">
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="外观与显示" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock FontSize="15" FontWeight="SemiBold" Text="主题" /><TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="深色更接近教室黑板，强光环境可切换浅色" /></StackPanel>
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="深色" Tag="Dark" /><ComboBoxItem Content="浅色" Tag="Light" /><ComboBoxItem Content="跟随系统" Tag="Default" />
                            </ComboBox>
                        </Grid>
                        <ComboBox x:Name="PaletteComboBox" Header="色系 · 文字、高光和磁贴" SelectedIndex="0" SelectionChanged="PaletteComboBox_SelectionChanged">
                            <ComboBoxItem Content="鲜艳" /><ComboBoxItem Content="马卡龙" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="科目与数据" />
                        <TextBlock FontSize="13" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="科目管理已经移到主看板，避免在展示页和编辑页之间来回切换。" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Click="ManageSubjectsButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="在看板上编辑" />
                            <Button Grid.Column="1" Click="ExportDataButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="导出备份包" />
                            <Button Grid.Column="2" Click="ImportDataButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="导入备份包" />
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel x:Name="ComponentSettingsPanel" Spacing="22" Visibility="Collapsed">
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="天气" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="使用 小米天气API ，请在下方选择地区" />
                        <ToggleSwitch x:Name="WeatherAlertsToggle" Header="显示极端天气预警" IsOn="True" Toggled="WeatherAlertsToggle_Toggled" />
                        <TextBlock x:Name="WeatherAlertsText" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="WeatherCityTextBox" Header="地区" Text="北京" IsReadOnly="True" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ChooseWeatherCityButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="选择地区" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="RefreshWeatherButton_Click" Style="{StaticResource BoardPrimaryButtonStyle}" Content="测试并刷新" />
                            <TextBlock x:Name="WeatherStatusText" MaxWidth="560" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="等待配置" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="麦克风噪音检测" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="只计算实时音量，不录音、不保存音频；系统拒绝麦克风权限时会停止检测。" />
                        <TextBlock x:Name="NoiseIntervalLabel" Text="检测间隔 · 0.1 秒" />
                        <Slider x:Name="NoiseIntervalSlider" Minimum="0.1" Maximum="2" StepFrequency="0.1" TickFrequency="0.1" SnapsTo="StepValues" Value="0.1" ValueChanged="NoiseIntervalSlider_ValueChanged" />
                        <ComboBox x:Name="MicrophoneDeviceComboBox" Header="输入设备" HorizontalAlignment="Stretch" SelectionChanged="MicrophoneDeviceComboBox_SelectionChanged" />
                        <Button Content="刷新输入设备" Click="RefreshMicrophoneDevices_Click" Style="{StaticResource BoardSecondaryButtonStyle}" />
                        <TextBlock x:Name="NoiseThresholdLabel" Text="吵闹阈值 · 60 dB" />
                        <Slider x:Name="NoiseThresholdSlider" Minimum="20" Maximum="120" StepFrequency="1" Value="60" ValueChanged="NoiseThresholdSlider_ValueChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <ToggleSwitch x:Name="NoiseAlertToggle" Header="吵闹时播放提示音" Toggled="NoiseAlertToggle_Toggled" />
                            <Button Content="试听 · 嘀嘀嘀" Click="PreviewNoiseAlert_Click" VerticalAlignment="Bottom" Style="{StaticResource BoardSecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="先选择当前环境的实际音量，再点击校准；更换麦克风后请重新校准。" TextWrapping="Wrap" />
                        <NumberBox x:Name="CalibrationTargetBox" Header="当前环境音量（dB）" Minimum="20" Maximum="120" Value="40" SmallChange="1" SpinButtonPlacementMode="Inline" />
                        <Button Content="校准到此音量" Click="CalibrateMicrophone_Click" Style="{StaticResource BoardPrimaryButtonStyle}" />
                        <TextBlock x:Name="MicrophoneCalibrationLabel" Text="校准偏移 · 0 dB" />
                        <InfoBar x:Name="MicrophoneStatusInfoBar" IsClosable="False" IsOpen="True" Severity="Informational" Message="正在等待麦克风启动" />
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel x:Name="AboutSettingsPanel" Spacing="24" Visibility="Collapsed">
                    <Border Style="{StaticResource BoardCardStyle}">
                        <StackPanel Spacing="24">
                            <TextBlock FontSize="22" Text="应用信息" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="版本" VerticalAlignment="Center" />
                                <TextBlock x:Name="AppVersionText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource BoardLineBrush}" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="项目仓库" VerticalAlignment="Center" />
                                <HyperlinkButton Grid.Column="1" NavigateUri="https://github.com/Edge-HH/Pancake" Background="{ThemeResource BoardSurfaceSecondaryBrush}" CornerRadius="8" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE943;" VerticalAlignment="Center" />
                                        <StackPanel><TextBlock Text="Edge-HH/Pancake" FontWeight="SemiBold" /><TextBlock Text="在 GitHub 中打开" FontSize="12" Foreground="{ThemeResource BoardTextSecondaryBrush}" /></StackPanel>
                                    </StackPanel>
                                </HyperlinkButton>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource BoardCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock FontSize="22" Text="更新" />
                            <TextBlock Text="从 GitHub Releases 获取并安装最新版本。" Foreground="{ThemeResource BoardTextSecondaryBrush}" />
                            <ToggleSwitch x:Name="AutoUpdateToggle" Header="启动时自动检查 GitHub Release" IsOn="True" Toggled="AutoUpdateToggle_Toggled" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="尚未检查" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Click="CheckUpdateButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="检查更新" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <!-- 主操作集中在屏幕下方，触屏时不需要跨越整块大屏。 -->
        <Border
            x:Name="FloatingToolbar"
            Grid.RowSpan="2"
            Margin="0,0,0,24"
            Padding="7"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource BoardSurfaceBrush}"
            BorderBrush="{ThemeResource BoardLineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="BackToBoardButton" Click="BackToBoardButton_Click" Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="返回看板">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <Button x:Name="DiscardEditButton" Click="DiscardEditButton_Click" Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="放弃修改">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
                <Button x:Name="AddSubjectButton" Click="AddSubjectButton_Click" Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="添加科目">
                    <FontIcon Glyph="&#xE710;" />
                </Button>
                <ToggleButton
                    x:Name="GridSnapToggleButton"
                    Width="44"
                    Height="44"
                    Padding="10"
                    Background="Transparent"
                    BorderThickness="0"
                    IsChecked="True"
                    Visibility="Collapsed"
                    AutomationProperties.Name="网格吸附"
                    Checked="GridSnapToggleButton_Checked"
                    Unchecked="GridSnapToggleButton_Unchecked">
                    <FontIcon FontSize="18" Glyph="&#xECA5;" />
                </ToggleButton>
                <Button x:Name="EditBoardButton" Click="EditBoardButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="编辑看板">
                    <FontIcon x:Name="EditBoardIcon" Glyph="&#xE70F;" />
                </Button>
                <Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="设置">
                    <FontIcon Glyph="&#xE713;" />
                </Button>
                <Button x:Name="FullScreenButton" Click="FullScreenButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="进入全屏">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" />
                        <TextBlock x:Name="FullScreenLabel" Text="退出全屏" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
