<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pancake.App"
             xmlns:fa="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <!-- FluentAvaloniaTheme 提供与 WinUI 对应的主题、强调色与控件样式。 -->
    <fa:FluentAvaloniaTheme PreferSystemTheme="False" />
    <!-- 与 WinUI 原版一致：普通文字统一使用随包字体。 -->
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="avares://Pancake.Ui/Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Pancake.Ui/Themes/ThemeResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
