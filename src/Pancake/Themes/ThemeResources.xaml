<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- 明确导航选中背景，避免系统色回退时白色底与白色标题重合。 -->
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2A2A35" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#353543" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F0F0F5" />
            <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#0E0E12" />
            <SolidColorBrush x:Key="BoardSurfaceBrush" Color="#16161E" />
            <SolidColorBrush x:Key="BoardSurfaceSecondaryBrush" Color="#1E1E28" />
            <SolidColorBrush x:Key="BoardSurfaceElevatedBrush" Color="#252532" />
            <SolidColorBrush x:Key="BoardTextBrush" Color="#F0F0F5" />
            <SolidColorBrush x:Key="GitHubIconBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardTextSecondaryBrush" Color="#A4A4B4" />
            <SolidColorBrush x:Key="BoardTextMutedBrush" Color="#737386" />
            <SolidColorBrush x:Key="BoardLineBrush" Color="#2A2A35" />
            <SolidColorBrush x:Key="BoardBrandBrush" Color="#6D70F6" />
            <SolidColorBrush x:Key="BoardBrandSoftBrush" Color="#2A2B58" />
            <SolidColorBrush x:Key="BoardSuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="BoardWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="BoardDangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="BoardPaperBrush" Color="#FFFDF7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#E6E6ED" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#DADAE3" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#000000" />
            <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardSurfaceSecondaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardSurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardTextBrush" Color="#000000" />
            <SolidColorBrush x:Key="GitHubIconBrush" Color="#000000" />
            <SolidColorBrush x:Key="BoardTextSecondaryBrush" Color="#555568" />
            <SolidColorBrush x:Key="BoardTextMutedBrush" Color="#747486" />
            <SolidColorBrush x:Key="BoardLineBrush" Color="#D9D9E6" />
            <SolidColorBrush x:Key="BoardBrandBrush" Color="#5457DB" />
            <SolidColorBrush x:Key="BoardBrandSoftBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="BoardWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="BoardDangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="BoardPaperBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 导航栏与内容区是相邻面板，内容层连接处不保留浮层式圆角。 -->
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
    <!-- 导航栏直接透出系统 Mica，避免默认 Acrylic 覆层把蓝色调冲淡。 -->
    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="LayerOnMicaBaseAltFillColorTransparentBrush" />
    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="LayerOnMicaBaseAltFillColorTransparentBrush" />

    <!-- 字体随程序分发，避免依赖系统版本。 -->
    <FontFamily x:Key="BoardIconFontFamily">ms-appx:///Assets/Fonts/FluentSystemIcons-Resizable.ttf#FluentSystemIcons-Resizable</FontFamily>

    <FontFamily x:Key="BoardTextFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BoardTextFontFamily}" /></Style>

    <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource BoardIconFontFamily}" />
    </Style>

    <Style x:Key="BoardIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <!-- 底部工具栏的所有可用操作使用同一高对比度颜色，避免前两个图标被误解为禁用状态。 -->
        <Setter Property="Foreground" Value="{ThemeResource BoardTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="InvisibleWidgetMoveThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="#01000000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WidgetResizeThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{ThemeResource BoardSurfaceElevatedBrush}" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoardPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BoardSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource BoardSurfaceSecondaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BoardTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BoardLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BoardCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BoardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BoardLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="BoardSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BoardTextBrush}" />
    </Style>
</ResourceDictionary>
