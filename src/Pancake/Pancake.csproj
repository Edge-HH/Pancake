<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 三端共用的 Avalonia 界面库；目标框架保持平台无关，由桌面入口决定具体平台。 -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Pancake</RootNamespace>
    <AssemblyName>Pancake.Ui</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pancake.Core\Pancake.Core.csproj" />
    <ProjectReference Include="..\Pancake.Platforms.Abstractions\Pancake.Platforms.Abstractions.csproj" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <!-- FluentAvaloniaUI 提供 NavigationView、InfoBar、NumberBox 等 WinUI 对应控件，界面按原版 Fluent 风格重写。 -->
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
    <!-- 视频背景：LibVLCSharp 提供托管绑定与 Avalonia 的 VideoView 控件（LGPL-2.1+）。 -->
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <!-- 统一 FluentAvalonia 传递依赖的 Avalonia 组件版本，避免与主包版本不一致。 -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <!-- DataGrid 使用独立的版本线，11.3.13 是 11.x 系列的最新版。 -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 字体与设置页配图随界面库一起编译为 Avalonia 资源，避免依赖系统字体。 -->
    <AvaloniaResource Include="Assets\Fonts\**" />
    <AvaloniaResource Include="Assets\Settings\**" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableUiVerification)' == 'true'">
    <!-- 与旧版一致：只有验证构建才带上界面自检入口，正式包不含这些代码。 -->
    <DefineConstants>$(DefineConstants);PANCAKE_UI_TESTS</DefineConstants>
  </PropertyGroup>

  <Import Project="../../Global.props" />
  <Import Project="../../AvaloniaShared.props" />
</Project>
