<Window x:ConnectionId='1'
    x:Class="PancakeBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PancakeBoard"
    xmlns:models="using:PancakeBoard.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PancakeBoard 班级作业看板"
    mc:Ignorable="d">

    <Grid x:ConnectionId='2'
        x:Name="RootShell"
        Background="{ThemeResource BoardBackgroundBrush}"
                                   
                                           >
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏在所有工作区保持一致，避免全屏大屏中迷失当前位置。 -->
        <Grid x:ConnectionId='3'
            x:Name="TopBar"
            Grid.Row="0"
            Padding="28,0,20,0"
            Background="{ThemeResource BoardBackgroundBrush}"
            BorderBrush="{ThemeResource BoardLineBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:ConnectionId='77' x:Name="DragRegion" Grid.ColumnSpan="2" Background="Transparent" />

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="38" Height="38" Background="{ThemeResource BoardBrandSoftBrush}" CornerRadius="10">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="19"
                        Foreground="{ThemeResource BoardBrandBrush}"
                        Glyph="&#xE823;" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource BoardTextBrush}"
                        Text="PancakeBoard" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource BoardTextMutedBrush}"
                        Text="班级作业看板" />
                </StackPanel>
                <Border
                    Margin="10,0,0,0"
                    Padding="10,5"
                    Background="{ThemeResource BoardSurfaceSecondaryBrush}"
                    CornerRadius="99">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource BoardSuccessBrush}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource BoardTextSecondaryBrush}"
                            Text="自习中" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:ConnectionId='78'
                x:Name="TopDateText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource BoardTextSecondaryBrush}"
                Text="2026年9月2日 星期三" />

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:ConnectionId='79'
                    x:Name="BackToBoardButton"
                    AutomationProperties.Name="返回展示页"
                                                   
                    Style="{StaticResource BoardSecondaryButtonStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                        <TextBlock Text="返回展示" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='80'
                    x:Name="EditBoardButton"
                    AutomationProperties.Name="编辑作业"
                                                 
                    Style="{StaticResource BoardPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" />
                        <TextBlock Text="编辑作业" />
                    </StackPanel>
                </Button>
                <Button x:ConnectionId='81'
                    x:Name="SettingsButton"
                    AutomationProperties.Name="设置"
                                                
                    Style="{StaticResource BoardIconButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE713;" />
                </Button>
                <Button x:ConnectionId='82'
                    x:Name="FullScreenButton"
                    AutomationProperties.Name="切换全屏"
                                                  
                    Style="{StaticResource BoardIconButtonStyle}">
                    <FontIcon x:ConnectionId='83' x:Name="FullScreenIcon" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 展示页 -->
        <Grid x:ConnectionId='4' x:Name="DisplayRoot" Grid.Row="1">
            <Grid x:ConnectionId='58' x:Name="DisplayGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="420" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <Border x:ConnectionId='59'
                    x:Name="ClockPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="48"
                    Background="{ThemeResource BoardBackgroundBrush}"
                    BorderBrush="{ThemeResource BoardLineBrush}"
                    BorderThickness="0,0,1,0">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <TextBlock x:ConnectionId='75'
                                    x:Name="MainTimeText"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="116"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource BoardTextBrush}"
                                    Text="11:20" />
                                <TextBlock x:ConnectionId='76'
                                    x:Name="SecondsText"
                                    Margin="0,17,0,0"
                                    VerticalAlignment="Top"
                                    FontFamily="Cascadia Code, Consolas"
                                    FontSize="34"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource BoardTextMutedBrush}"
                                    Text="10" />
                            </StackPanel>

                            <TextBlock x:ConnectionId='73'
                                x:Name="ClockDateText"
                                HorizontalAlignment="Center"
                                FontSize="22"
                                Foreground="{ThemeResource BoardTextSecondaryBrush}"
                                Text="2026年9月2日 星期三" />

                            <Rectangle
                                Width="128"
                                Height="1"
                                Margin="0,8"
                                Fill="{ThemeResource BoardLineBrush}" />

                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="14">
                                <Border Padding="18,12" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="20"
                                            Foreground="{ThemeResource BoardWarningBrush}"
                                            Glyph="&#xE706;" />
                                        <StackPanel Spacing="1">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="北京 · 天气" />
                                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="晴  27°C" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Padding="18,12" Background="{ThemeResource BoardSurfaceBrush}" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="20"
                                            Foreground="{ThemeResource BoardSuccessBrush}"
                                            Glyph="&#xE720;" />
                                        <StackPanel Spacing="1">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="教室噪声" />
                                            <TextBlock x:ConnectionId='74' x:Name="NoiseText" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="42 dB · 安静" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource BoardTextMutedBrush}"
                                Text="天气更新于 10 分钟前 · 噪声数据仅在本机处理" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:ConnectionId='60'
                    x:Name="CardsPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="30"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="今日作业" />
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource BoardTextSecondaryBrush}"
                                    Text="点击科目卡片可查看大号详情" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Padding="12,7"
                                VerticalAlignment="Center"
                                Background="{ThemeResource BoardSurfaceSecondaryBrush}"
                                CornerRadius="99">
                                <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="4 个科目" />
                            </Border>
                        </Grid>

                        <GridView x:ConnectionId='61'
                            x:Name="SubjectGridView"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            IsItemClickEnabled="False"
                                                                                  
                                                                         
                            SelectionMode="None"
                                                                     >
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemHeight="280" ItemWidth="400" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate                                 >
                                    <Button x:ConnectionId='63'
                                        MinHeight="248"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                                                                 
                                        Background="Transparent"
                                        BorderThickness="0"
                                                                 >
                                        <Border
                                            Margin="0,0,20,20"
                                            Padding="0"
                                            Background="{ThemeResource BoardSurfaceBrush}"
                                            BorderBrush="{ThemeResource BoardLineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                            <Grid>
                                                <Rectangle x:ConnectionId='64' Height="4" VerticalAlignment="Top"                             RadiusX="2" RadiusY="2" />
                                                <TextBlock x:ConnectionId='65'
                                                    Margin="0,0,-10,-12"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    FontSize="68"
                                                    FontWeight="Bold"
                                                                                     
                                                    IsHitTestVisible="False"
                                                    Opacity="0.055"
                                                                              />
                                                <StackPanel Margin="24,22" Spacing="16">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="3">
                                                            <TextBlock x:ConnectionId='71' FontSize="23" FontWeight="SemiBold"                                                        />
                                                            <TextBlock x:ConnectionId='72' FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}"                                         />
                                                        </StackPanel>
                                                        <FontIcon
                                                            Grid.Column="1"
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="16"
                                                            Foreground="{ThemeResource BoardTextMutedBrush}"
                                                            Glyph="&#xE76C;" />
                                                    </Grid>
                                                    <ItemsControl x:ConnectionId='66'                               >
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate                                  >
                                                                <StackPanel x:ConnectionId='68' Margin="0,0,0,12" Spacing="7">
                                                                    <Grid ColumnSpacing="10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Ellipse
                                                                            Width="6"
                                                                            Height="6"
                                                                            Margin="0,4,0,0"
                                                                            VerticalAlignment="Top"
                                                                            Fill="{ThemeResource BoardTextMutedBrush}" />
                                                                        <TextBlock x:ConnectionId='70'
                                                                            Grid.Column="1"
                                                                            MaxLines="3"
                                                                            FontSize="17"
                                                                            Foreground="{ThemeResource BoardTextBrush}"
                                                                            LineHeight="25"
                                                                                                                
                                                                            TextTrimming="CharacterEllipsis"
                                                                            TextWrapping="Wrap" />
                                                                    </Grid>
                                                                    <Border
                                                                        Margin="22,0,0,0"
                                                                        Padding="9,5"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{ThemeResource BoardSurfaceSecondaryBrush}"
                                                                        CornerRadius="6">
                                                                        <TextBlock x:ConnectionId='69' FontSize="11" Foreground="{ThemeResource BoardTextSecondaryBrush}"                                                />
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 编辑页：科目、作业和内容三栏，不把复杂操作塞回展示页。 -->
        <Grid x:ConnectionId='5' x:Name="EditorRoot" Grid.Row="1" Padding="24" ColumnSpacing="18" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource BoardCardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="科目" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="选择要编辑的科目" />
                    </StackPanel>
                    <ListView x:ConnectionId='50'
                        x:Name="SubjectList"
                        Grid.Row="1"
                                                                              
                                                                                      
                                                                       
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate                                 >
                                <Grid x:ConnectionId='54' MinHeight="52" Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:ConnectionId='55' Width="10" Height="10"                             />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock x:ConnectionId='56' FontSize="15" FontWeight="SemiBold"                      />
                                        <TextBlock x:ConnectionId='57' FontSize="11" Foreground="{ThemeResource BoardTextMutedBrush}"                                         />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Button x:ConnectionId='51'                                HorizontalAlignment="Stretch" Style="{StaticResource BoardSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                                <TextBlock Text="添加科目" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='52'                                   HorizontalAlignment="Stretch" Foreground="{ThemeResource BoardDangerBrush}" Style="{StaticResource BoardIconButtonStyle}">
                            <TextBlock Text="删除当前科目" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource BoardCardStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="作业内容" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="同一科目可添加多条" />
                    </StackPanel>
                    <ListView x:ConnectionId='43'
                        x:Name="HomeworkList"
                        Grid.Row="1"
                                                                                             
                                                                                       
                                                                        
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate                                  >
                                <StackPanel x:ConnectionId='47' MinHeight="72" Padding="4" Spacing="5">
                                    <TextBlock x:ConnectionId='48' MaxLines="2" FontSize="14" LineHeight="20"                                      TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    <TextBlock x:ConnectionId='49' FontSize="11" Foreground="{ThemeResource BoardTextMutedBrush}"                                                />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:ConnectionId='44'                                 HorizontalAlignment="Stretch" Style="{StaticResource BoardPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                                <TextBlock Text="新建作业" />
                            </StackPanel>
                        </Button>
                        <Button x:ConnectionId='45' Grid.Column="1" AutomationProperties.Name="删除作业"                                    Style="{StaticResource BoardIconButtonStyle}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource BoardDangerBrush}" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource BoardCardStyle}">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="编辑内容" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="草稿会自动保留，完成编辑后才更新展示页" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="10,6" VerticalAlignment="Center" Background="{ThemeResource BoardBrandSoftBrush}" CornerRadius="99">
                            <TextBlock FontSize="12" Foreground="{ThemeResource BoardBrandBrush}" Text="草稿已保存" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="22">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="文字内容" />
                                <TextBox x:ConnectionId='40'
                                    x:Name="HomeworkTextBox"
                                    MinHeight="220"
                                    AcceptsReturn="True"
                                    PlaceholderText="输入作业内容，可使用换行、项目符号或编号……"
                                                                                                                                        
                                                                             
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:ConnectionId='41'                                  Style="{StaticResource BoardSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FD;" />
                                            <TextBlock Text="项目符号" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:ConnectionId='42'                                  Style="{StaticResource BoardSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEA37;" />
                                            <TextBlock Text="编号" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="附件" />
                                    <Button x:ConnectionId='39' Grid.Column="1"                                   Style="{StaticResource BoardSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE723;" />
                                            <TextBlock Text="添加附件" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:ConnectionId='31'                                                                           >
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate                                   >
                                            <Border x:ConnectionId='33' Margin="0,0,0,8" Padding="12" Background="{ThemeResource BoardSurfaceSecondaryBrush}" CornerRadius="10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" Background="{ThemeResource BoardBrandSoftBrush}" CornerRadius="8">
                                                        <FontIcon x:ConnectionId='38' FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource BoardBrandBrush}"                        />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock x:ConnectionId='36' FontSize="14"                      TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:ConnectionId='37' FontSize="11" Foreground="{ThemeResource BoardTextMutedBrush}"                      />
                                                    </StackPanel>
                                                    <Button x:ConnectionId='34' Grid.Column="2" AutomationProperties.Name="打开附件"                                    Style="{StaticResource BoardIconButtonStyle}">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A7;" />
                                                    </Button>
                                                    <Button x:ConnectionId='35' Grid.Column="3" AutomationProperties.Name="移除附件"                                      Style="{StaticResource BoardIconButtonStyle}">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource BoardDangerBrush}" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Padding="18" Background="{ThemeResource BoardSurfaceSecondaryBrush}" CornerRadius="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" Background="{ThemeResource BoardBrandSoftBrush}" CornerRadius="10">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{ThemeResource BoardBrandBrush}" Glyph="&#xED63;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="手写笔记" />
                                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="使用手指或触控笔绘制，鼠标不会落笔" />
                                    </StackPanel>
                                    <Button x:ConnectionId='30' Grid.Column="2"                             Style="{StaticResource BoardPrimaryButtonStyle}" Content="打开画布" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="所有改动目前仅用于 UI 演示" />
                        <Button x:ConnectionId='28' Grid.Column="1"                                 Style="{StaticResource BoardSecondaryButtonStyle}" Content="放弃修改" />
                        <Button x:ConnectionId='29' Grid.Column="2"                                 Style="{StaticResource BoardPrimaryButtonStyle}" Content="完成编辑" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 设置页 -->
        <ScrollViewer x:ConnectionId='6' x:Name="SettingsRoot" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" Padding="40,32,40,64" HorizontalAlignment="Center" Spacing="24">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="设置" />
                    <TextBlock FontSize="15" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="调整大屏外观、环境信息和数据管理方式" />
                </StackPanel>

                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="20">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="外观与显示" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="主题" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="深色适合自习环境，强光教室可切换浅色" />
                            </StackPanel>
                            <ComboBox x:ConnectionId='27' x:Name="ThemeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"                                                  >
                                <ComboBoxItem Content="深色" Tag="Dark" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="跟随系统" Tag="Default" />
                            </ComboBox>
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="启动时进入全屏" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="之后会记住上一次的窗口状态" />
                            </StackPanel>
                            <ToggleSwitch x:ConnectionId='26' x:Name="StartFullScreenSwitch" Grid.Column="1" IsOn="True" />
                        </Grid>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="自动轮播更多科目" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="只在科目超过一屏时缓慢滚动" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="False" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="20">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="天气" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="城市" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="固定教室无需请求系统定位" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="北京市" PlaceholderText="输入城市" />
                        </Grid>
                        <InfoBar IsClosable="False" IsOpen="True" Message="当前 UI 阶段使用模拟天气；接入服务后会保留最近一次成功结果并显示更新时间。" Severity="Informational" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="噪声检测" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="显示教室噪声" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="只分析音量，不录音也不保存声音" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="True" />
                        </Grid>
                        <TextBlock FontSize="13" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="安静上限 · 45 dB" />
                        <Slider Minimum="30" Maximum="70" Value="45" StepFrequency="1" />
                        <TextBlock FontSize="13" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="偏吵起点 · 60 dB" />
                        <Slider Minimum="40" Maximum="90" Value="60" StepFrequency="1" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="科目与数据" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:ConnectionId='23'                                    Style="{StaticResource BoardSecondaryButtonStyle}" Content="管理科目" />
                            <Button x:ConnectionId='24' Grid.Column="1"                                Style="{StaticResource BoardSecondaryButtonStyle}" Content="导出备份包" />
                            <Button x:ConnectionId='25' Grid.Column="2"                                Style="{StaticResource BoardSecondaryButtonStyle}" Content="导入备份包" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 手写画布是覆盖层，保留编辑上下文。WinUI 1.8 稳定版尚无 InkCanvas，因此使用原生指针轨迹画布。 -->
        <Grid x:ConnectionId='7' x:Name="InkOverlay" Grid.RowSpan="2" Background="#CC08080C" Visibility="Collapsed">
            <Border Margin="40" Padding="0" Background="{ThemeResource BoardSurfaceElevatedBrush}" CornerRadius="18">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="68" />
                    </Grid.RowDefinitions>
                    <Grid Padding="22,0" BorderBrush="{ThemeResource BoardLineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="手写笔记" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="使用手指或触控笔绘制，鼠标仅用于点击工具栏" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleButton x:ConnectionId='17' x:Name="PenToolButton" IsChecked="True"                             MinWidth="88">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED63;" /><TextBlock Text="钢笔" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:ConnectionId='18' x:Name="HighlighterToolButton"                                     MinWidth="100">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE82F;" /><TextBlock Text="荧光笔" /></StackPanel>
                            </ToggleButton>
                            <ToggleButton x:ConnectionId='19' x:Name="EraserToolButton"                                MinWidth="88">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE75C;" /><TextBlock Text="橡皮" /></StackPanel>
                            </ToggleButton>
                            <Button x:ConnectionId='20' AutomationProperties.Name="撤销"                             Style="{StaticResource BoardIconButtonStyle}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" /></Button>
                            <Button x:ConnectionId='21' AutomationProperties.Name="重做"                             Style="{StaticResource BoardIconButtonStyle}"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A6;" /></Button>
                            <Button x:ConnectionId='22'                              Foreground="{ThemeResource BoardDangerBrush}" Style="{StaticResource BoardIconButtonStyle}" Content="清空" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="18" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="16">
                            <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="颜色" />
                            <Button x:ConnectionId='13' Tag="#202028"                              AutomationProperties.Name="黑色画笔" Width="48" Height="48" Padding="0" Background="#202028" CornerRadius="24" />
                            <Button x:ConnectionId='14' Tag="#4F46E5"                              AutomationProperties.Name="蓝紫色画笔" Width="48" Height="48" Padding="0" Background="#4F46E5" CornerRadius="24" />
                            <Button x:ConnectionId='15' Tag="#DC2626"                              AutomationProperties.Name="红色画笔" Width="48" Height="48" Padding="0" Background="#DC2626" CornerRadius="24" />
                            <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="粗细" />
                            <Slider x:ConnectionId='16' x:Name="InkThicknessSlider" Height="180" Minimum="2" Maximum="18" Orientation="Vertical" Value="5" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource BoardPaperBrush}" BorderBrush="#D8D5CB" BorderThickness="1" CornerRadius="12">
                            <Canvas x:ConnectionId='12'
                                x:Name="DrawingCanvas"
                                Background="Transparent"
                                ManipulationMode="None"
                                                                               
                                                                         
                                                                             
                                                                                />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Padding="22,10" BorderBrush="{ThemeResource BoardLineBrush}" BorderThickness="0,1,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="手写内容将在功能阶段保存为可继续编辑的笔迹数据" />
                        <Button x:ConnectionId='10' Grid.Column="1"                               Style="{StaticResource BoardSecondaryButtonStyle}" Content="取消" />
                        <Button x:ConnectionId='11' Grid.Column="2"                             Style="{StaticResource BoardPrimaryButtonStyle}" Content="保存笔记" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:ConnectionId='8'
            x:Name="UndoInfoBar"
            Grid.Row="1"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="False"
            Message="已删除一条作业"
            Severity="Success">
            <InfoBar.ActionButton>
                <Button x:ConnectionId='9'                                Content="撤销" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>

