<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#0E0E12" />
            <SolidColorBrush x:Key="BoardSurfaceBrush" Color="#16161E" />
            <SolidColorBrush x:Key="BoardSurfaceSecondaryBrush" Color="#1E1E28" />
            <SolidColorBrush x:Key="BoardSurfaceElevatedBrush" Color="#252532" />
            <SolidColorBrush x:Key="BoardTextBrush" Color="#F0F0F5" />
            <SolidColorBrush x:Key="BoardTextSecondaryBrush" Color="#A4A4B4" />
            <SolidColorBrush x:Key="BoardTextMutedBrush" Color="#737386" />
            <SolidColorBrush x:Key="BoardLineBrush" Color="#2A2A35" />
            <SolidColorBrush x:Key="BoardBrandBrush" Color="#6D70F6" />
            <SolidColorBrush x:Key="BoardBrandSoftBrush" Color="#2A2B58" />
            <SolidColorBrush x:Key="BoardSuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="BoardWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="BoardDangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="BoardPaperBrush" Color="#FFFDF7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BoardBackgroundBrush" Color="#F5F5FA" />
            <SolidColorBrush x:Key="BoardSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardSurfaceSecondaryBrush" Color="#ECECF4" />
            <SolidColorBrush x:Key="BoardSurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BoardTextBrush" Color="#1E1E28" />
            <SolidColorBrush x:Key="BoardTextSecondaryBrush" Color="#555568" />
            <SolidColorBrush x:Key="BoardTextMutedBrush" Color="#747486" />
            <SolidColorBrush x:Key="BoardLineBrush" Color="#D9D9E6" />
            <SolidColorBrush x:Key="BoardBrandBrush" Color="#5457DB" />
            <SolidColorBrush x:Key="BoardBrandSoftBrush" Color="#E5E5FF" />
            <SolidColorBrush x:Key="BoardSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="BoardWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="BoardDangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="BoardPaperBrush" Color="#FFFDF7" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="BoardIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource BoardTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="BoardPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource BoardBrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BoardSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource BoardSurfaceSecondaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource BoardTextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BoardLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BoardCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BoardSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BoardLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="BoardSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BoardTextBrush}" />
    </Style>
</ResourceDictionary>

