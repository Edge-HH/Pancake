<Window
    x:Class="PancakeBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PancakeBoard 班级作业看板">

    <Grid x:ConnectionId='2' x:Name="RootShell" Background="{ThemeResource BoardBackgroundBrush}"                                                                >
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,0" Background="#1E1E1E" BorderBrush="#292929" BorderThickness="0,0,0,1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:ConnectionId='42' x:Name="DragRegion" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="38" Height="38" Background="#101010" CornerRadius="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource BoardBrandBrush}" Glyph="&#xE823;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White" Text="PancakeBoard" />
                        <TextBlock FontSize="11" Foreground="#999999" Text="班级作业看板" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <TextBlock x:ConnectionId='43' x:Name="TopDateText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#AAAAAA" />
        </Grid>

        <Grid x:ConnectionId='3' x:Name="DisplayRoot" Grid.Row="1">
            <Grid x:ConnectionId='28' x:Name="DisplayGrid">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="400" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Border x:ConnectionId='29' x:Name="ClockPanel" Grid.Row="0" Grid.Column="0" Background="#020202" BorderBrush="#5A5A5A" BorderThickness="0,0,1,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <TextBlock x:ConnectionId='40' x:Name="MainTimeText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="112" FontWeight="Light" Foreground="White" Text="11:20" />
                            <TextBlock x:ConnectionId='41' x:Name="SecondsText" Margin="0,17,0,0" VerticalAlignment="Top" FontFamily="Cascadia Code, Consolas" FontSize="28" Foreground="#8D8D8D" Text="10" />
                        </StackPanel>
                        <TextBlock x:ConnectionId='37' x:Name="ClockDateText" HorizontalAlignment="Center" FontSize="20" Foreground="#B4B4B4" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Padding="16,10" Background="#151515" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource BoardWarningBrush}" Glyph="&#xE706;" /><TextBlock x:ConnectionId='39' x:Name="WeatherText" FontSize="14" Foreground="#DEDEDE" Text="天气未配置" /></StackPanel>
                            </Border>
                            <Border Padding="16,10" Background="#151515" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource BoardSuccessBrush}" Glyph="&#xE720;" /><TextBlock x:ConnectionId='38' x:Name="NoiseText" FontSize="14" Foreground="#DEDEDE" Text="42 dB · 安静" /></StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid x:ConnectionId='30' x:Name="BoardWorkspace" Grid.Row="0" Grid.Column="1" Background="#151515">
                    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="30,0,24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" Text="今日作业" />
                            <TextBlock x:ConnectionId='36' x:Name="BoardModeHint" FontSize="12" Foreground="#969696" Text="所有文字和笔迹都完整显示在磁贴上" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="11,6" VerticalAlignment="Center" Background="#080808" CornerRadius="8">
                            <TextBlock x:ConnectionId='35' x:Name="SubjectCountText" FontSize="12" Foreground="#B9B9B9" />
                        </Border>
                    </Grid>
                    <ScrollViewer x:ConnectionId='31' x:Name="BoardScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"                                             ZoomMode="Disabled">
                        <Grid x:ConnectionId='32' x:Name="BoardSurface" Width="1100" Height="780" Background="#151515">
                            <Canvas x:ConnectionId='33' x:Name="GridCanvas" IsHitTestVisible="False" />
                            <Canvas x:ConnectionId='34' x:Name="BoardCanvas" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <ScrollViewer x:ConnectionId='4' x:Name="SettingsRoot" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Padding="40,34,40,64" HorizontalAlignment="Center" Spacing="22">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="设置" />
                    <TextBlock FontSize="14" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="调整大屏外观、环境信息和数据管理方式" />
                </StackPanel>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="外观与显示" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock FontSize="15" FontWeight="SemiBold" Text="主题" /><TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="深色更接近教室黑板，强光环境可切换浅色" /></StackPanel>
                            <ComboBox x:ConnectionId='27' x:Name="ThemeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"                                                  >
                                <ComboBoxItem Content="深色" Tag="Dark" /><ComboBoxItem Content="浅色" Tag="Light" /><ComboBoxItem Content="跟随系统" Tag="Default" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="小米天气 API" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="端点模板支持 {city} 和 {key} 占位符；密钥只保存在当前运行内存中。" />
                        <TextBox x:ConnectionId='22' x:Name="WeatherEndpointTextBox" Header="官方端点模板" PlaceholderText="https://example.xiaomi.com/weather?city={city}&amp;key={key}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBox x:ConnectionId='25' x:Name="WeatherCityTextBox" Header="城市" Text="北京市" />
                            <PasswordBox x:ConnectionId='26' x:Name="WeatherApiKeyBox" Grid.Column="1" Header="API 密钥" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:ConnectionId='23'                                    Style="{StaticResource BoardPrimaryButtonStyle}" Content="测试并刷新" />
                            <TextBlock x:ConnectionId='24' x:Name="WeatherStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="等待配置" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="麦克风噪音检测" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="只计算实时音量，不录音、不保存音频；系统拒绝麦克风权限时会停止检测。" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock FontSize="15" FontWeight="SemiBold" Text="采样率" /><TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="较高采样率更细致，也会增加少量计算量" /></StackPanel>
                            <ComboBox x:ConnectionId='21' x:Name="MicrophoneSampleRateComboBox" Grid.Column="1" SelectedIndex="1"                                                                 >
                                <ComboBoxItem Content="8000 Hz" Tag="8000" /><ComboBoxItem Content="16000 Hz" Tag="16000" /><ComboBoxItem Content="22050 Hz" Tag="22050" /><ComboBoxItem Content="44100 Hz" Tag="44100" /><ComboBoxItem Content="48000 Hz" Tag="48000" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:ConnectionId='18' x:Name="MicrophoneCalibrationLabel" FontSize="13" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="校准偏移 · 0 dB" />
                        <Slider x:ConnectionId='19' x:Name="MicrophoneCalibrationSlider" Minimum="-30" Maximum="30" StepFrequency="1" Value="0"                                                         />
                        <InfoBar x:ConnectionId='20' x:Name="MicrophoneStatusInfoBar" IsClosable="False" IsOpen="True" Severity="Informational" Message="正在等待麦克风启动" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="科目与数据" />
                        <TextBlock FontSize="13" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="科目管理已经移到主看板，避免在展示页和编辑页之间来回切换。" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:ConnectionId='15'                                    Style="{StaticResource BoardSecondaryButtonStyle}" Content="在看板上编辑" />
                            <Button x:ConnectionId='16' Grid.Column="1"                                Style="{StaticResource BoardSecondaryButtonStyle}" Content="导出备份包" />
                            <Button x:ConnectionId='17' Grid.Column="2"                                Style="{StaticResource BoardSecondaryButtonStyle}" Content="导入备份包" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 主操作集中在屏幕下方，触屏时不需要跨越整块大屏。 -->
        <Border x:ConnectionId='5'
            x:Name="FloatingToolbar"
            Grid.RowSpan="2"
            Margin="0,0,0,24"
            Padding="7"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#F009090B"
            BorderBrush="#55555C"
            BorderThickness="1"
            CornerRadius="14"
            Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:ConnectionId='6' x:Name="BackToBoardButton"                                 Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="返回看板">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                </Button>
                <Button x:ConnectionId='7' x:Name="DiscardEditButton"                                 Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="放弃修改">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" />
                </Button>
                <Button x:ConnectionId='8' x:Name="AddSubjectButton"                                Style="{StaticResource BoardIconButtonStyle}" Visibility="Collapsed" AutomationProperties.Name="添加科目">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" />
                </Button>
                <Button x:ConnectionId='9' x:Name="EditBoardButton"                               Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="编辑看板">
                    <FontIcon x:ConnectionId='14' x:Name="EditBoardIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" />
                </Button>
                <Button x:ConnectionId='10' x:Name="SettingsButton"                              Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="设置">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" />
                </Button>
                <Button x:ConnectionId='11' x:Name="FullScreenButton"                                Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="退出全屏">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon x:ConnectionId='12' x:Name="FullScreenIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" />
                        <TextBlock x:ConnectionId='13' x:Name="FullScreenLabel" Text="退出全屏" Visibility="Collapsed" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

