<Window
    x:Class="PancakeBoard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PancakeBoard 班级作业看板">

    <Grid x:Name="RootShell" Background="{ThemeResource BoardBackgroundBrush}" KeyDown="RootShell_KeyDown" SizeChanged="RootShell_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,0,18,0" Background="#1E1E1E" BorderBrush="#292929" BorderThickness="0,0,0,1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragRegion" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="38" Height="38" Background="#101010" CornerRadius="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource BoardBrandBrush}" Glyph="&#xE823;" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="White" Text="PancakeBoard" />
                        <TextBlock FontSize="11" Foreground="#999999" Text="班级作业看板" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="TopDateText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="#AAAAAA" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button x:Name="BackToBoardButton" Click="BackToBoardButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" /><TextBlock Text="返回看板" /></StackPanel>
                </Button>
                <Button x:Name="DiscardEditButton" Click="DiscardEditButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Visibility="Collapsed" Content="放弃修改" />
                <Button x:Name="AddSubjectButton" Click="AddSubjectButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" /><TextBlock Text="添加科目" /></StackPanel>
                </Button>
                <Button x:Name="EditBoardButton" Click="EditBoardButton_Click" Style="{StaticResource BoardPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon x:Name="EditBoardIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" /><TextBlock x:Name="EditBoardText" Text="直接编辑" /></StackPanel>
                </Button>
                <Button Click="SettingsButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="设置">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="17" Glyph="&#xE713;" />
                </Button>
                <Button Click="FullScreenButton_Click" Style="{StaticResource BoardIconButtonStyle}" AutomationProperties.Name="切换全屏">
                    <FontIcon x:Name="FullScreenIcon" FontFamily="Segoe Fluent Icons" FontSize="17" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="DisplayRoot" Grid.Row="1">
            <Grid x:Name="DisplayGrid">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="400" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Border x:Name="ClockPanel" Grid.Row="0" Grid.Column="0" Background="#020202" BorderBrush="#5A5A5A" BorderThickness="0,0,1,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="MainTimeText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="112" FontWeight="Light" Foreground="White" Text="11:20" />
                            <TextBlock x:Name="SecondsText" Margin="0,17,0,0" VerticalAlignment="Top" FontFamily="Cascadia Code, Consolas" FontSize="28" Foreground="#8D8D8D" Text="10" />
                        </StackPanel>
                        <TextBlock x:Name="ClockDateText" HorizontalAlignment="Center" FontSize="20" Foreground="#B4B4B4" />
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Padding="16,10" Background="#151515" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource BoardWarningBrush}" Glyph="&#xE706;" /><TextBlock FontSize="14" Foreground="#DEDEDE" Text="晴  27°C" /></StackPanel>
                            </Border>
                            <Border Padding="16,10" Background="#151515" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="9"><FontIcon FontFamily="Segoe Fluent Icons" Foreground="{ThemeResource BoardSuccessBrush}" Glyph="&#xE720;" /><TextBlock x:Name="NoiseText" FontSize="14" Foreground="#DEDEDE" Text="42 dB · 安静" /></StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid x:Name="BoardWorkspace" Grid.Row="0" Grid.Column="1" Background="#151515">
                    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="30,0,24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" Text="今日作业" />
                            <TextBlock x:Name="BoardModeHint" FontSize="12" Foreground="#969696" Text="所有文字和笔迹都完整显示在磁贴上" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="11,6" VerticalAlignment="Center" Background="#080808" CornerRadius="8">
                            <TextBlock x:Name="SubjectCountText" FontSize="12" Foreground="#B9B9B9" />
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="BoardScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" ZoomMode="Disabled">
                        <Canvas x:Name="BoardCanvas" Width="1100" Height="780" Background="#151515" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <ScrollViewer x:Name="SettingsRoot" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Padding="40,34,40,64" HorizontalAlignment="Center" Spacing="22">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource BoardTextBrush}" Text="设置" />
                    <TextBlock FontSize="14" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="调整大屏外观、环境信息和数据管理方式" />
                </StackPanel>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="外观与显示" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock FontSize="15" FontWeight="SemiBold" Text="主题" /><TextBlock FontSize="12" Foreground="{ThemeResource BoardTextMutedBrush}" Text="深色更接近教室黑板，强光环境可切换浅色" /></StackPanel>
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="深色" Tag="Dark" /><ComboBoxItem Content="浅色" Tag="Light" /><ComboBoxItem Content="跟随系统" Tag="Default" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource BoardCardStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Style="{StaticResource BoardSectionTitleStyle}" Text="科目与数据" />
                        <TextBlock FontSize="13" Foreground="{ThemeResource BoardTextSecondaryBrush}" Text="科目管理已经移到主看板，避免在展示页和编辑页之间来回切换。" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Click="ManageSubjectsButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="在看板上编辑" />
                            <Button Grid.Column="1" Click="ExportDataButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="导出备份包" />
                            <Button Grid.Column="2" Click="ImportDataButton_Click" Style="{StaticResource BoardSecondaryButtonStyle}" Content="导入备份包" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
