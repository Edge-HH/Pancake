<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pancake.Server</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.1.0</Version>
    <!-- 本地 dotnet publish/build -o artifacts 的输出不能再被当作内容文件递归打包。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;*.db;*.db-*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pancake.Shared\Pancake.Shared.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.20">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.20" />
  </ItemGroup>
  <!-- 网页设置预览与大屏使用同一套字体、图标和示例底图，直接取桌面端的资源，避免两份文件不同步。 -->
  <ItemGroup>
    <None Include="..\Pancake\Assets\Fonts\HarmonyOS_Sans_SC_*.ttf;..\Pancake\Assets\Fonts\FluentSystemIcons-Resizable.ttf;..\Pancake\Assets\Settings\tile-preview-background.png"
          Link="board-assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
