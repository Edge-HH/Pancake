<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- 桌面端同步服务与真实服务端的端到端测试：直接编译桌面端的纯逻辑文件，不依赖 WinUI。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Pancake.Server/Pancake.Server.csproj" />
    <Compile Include="../../src/Pancake/Services/ProjectState.cs" Link="Desktop/ProjectState.cs" />
    <Compile Include="../../src/Pancake/Services/ProjectStore.cs" Link="Desktop/ProjectStore.cs" />
    <Compile Include="../../src/Pancake/Services/CloudPayload.cs" Link="Desktop/CloudPayload.cs" />
    <Compile Include="../../src/Pancake/Services/CloudSyncService.cs" Link="Desktop/CloudSyncService.cs" />
    <Compile Include="../../src/Pancake/Services/CloudRealtimeClient.cs" Link="Desktop/CloudRealtimeClient.cs" />
    <Compile Include="../../src/Pancake/Services/BoardNotices.cs" Link="Desktop/BoardNotices.cs" />
    <Compile Include="../../src/Pancake/Services/SettingsCopy.cs" Link="Desktop/SettingsCopy.cs" />
    <Compile Include="../../src/Pancake/Services/ProjectMerge.cs" Link="Desktop/ProjectMerge.cs" />
  </ItemGroup>
</Project>
