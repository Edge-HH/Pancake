<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pancake.Core\Pancake.Core.csproj" />
    <!-- 覆盖式更新依赖 7-Zip 与 PowerShell 脚本，这两项资源只随 Windows 平台工程分发。 -->
    <Content Include="..\..\src\platforms\Pancake.Platforms.Windows\Tools\7zip\**\*"
             Link="Tools\7zip\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\platforms\Pancake.Platforms.Windows\ApplyUpdate.ps1"
             Link="ApplyUpdate.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
