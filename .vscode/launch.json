{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pancake",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Pancake (Debug x64)",
      "program": "${workspaceFolder}/src/Pancake/bin/Debug/net8.0-windows10.0.19041.0/win-x64/Pancake.exe",
      "cwd": "${workspaceFolder}/src/Pancake",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Pancake Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Pancake.Server (Debug)",
      "program": "${workspaceFolder}/src/Pancake.Server/bin/Debug/net8.0/Pancake.Server.dll",
      "cwd": "${workspaceFolder}/src/Pancake.Server",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "justMyCode": true,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
