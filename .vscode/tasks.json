{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build PancakeBoard (Debug x64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/PancakeBoard.slnx",
        "--configuration",
        "Debug",
        "--property:Platform=x64"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build PancakeBoard (Release x64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/PancakeBoard.slnx",
        "--configuration",
        "Release",
        "--property:Platform=x64"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
